package com.mycompany.numberguess;

import java.util.Scanner;
import java.util.Random;
import java.util.ArrayList;

/**
 *
 * @author acalabrese2027
 */
public class Numberguess {

    public static void main(String[] args) {

        Game game = new Game();

        game.startGame();

    }
}

// Game class
class Game {

    private final Scanner input = new Scanner(System.in);
    private final Random random = new Random();

    private final int MAX_GUESSES = 6;

    private int secretNumber;
    private int guessesUsed;

    private ArrayList<Integer> guessHistory = new ArrayList<>();

    public void startGame() {

        System.out.println("=================================");
        System.out.println("       NUMBER GUESSING GAME");
        System.out.println("=================================");

        System.out.println("Welcome to the Number Guessing Game!");
        System.out.println("I am thinking of a number between 1 and 100.");
        System.out.println("You have 6 guesses to figure it out.");
        System.out.println("I will tell you if your guess is too high or too low.");
        System.out.println();

        System.out.print("Enter your name: ");
        String name = input.nextLine();

        Player player = new Player(name);

        secretNumber = random.nextInt(100) + 1;
        guessesUsed = 0;

        boolean correct = false;

        while (guessesUsed < MAX_GUESSES && !correct) {

            System.out.println("---------------------------------");
            System.out.println("Guesses remaining: "
                    + (MAX_GUESSES - guessesUsed));

            System.out.print("Enter your guess (1-100): ");

            if (!input.hasNextInt()) {

                System.out.println("Invalid input! Please enter a whole number.");
                input.nextLine();
                continue;
            }

            int guess = input.nextInt();

            if (guess < 1 || guess > 100) {

                System.out.println("Please enter a number between 1 and 100.");
                continue;
            }

            guessesUsed++;

            guessHistory.add(guess);
            player.addGuess(guess);

            if (guess == secretNumber) {

                System.out.println();
                System.out.println("CORRECT! You guessed the number!");
                System.out.println("Congratulations, " + player.getName() + "!");
                System.out.println("You won in " + guessesUsed + " guesses!");

                correct = true;

            } else if (guess < secretNumber) {

                System.out.println("Too low! The secret number is GREATER.");

            } else {

                System.out.println("Too high! The secret number is SMALLER.");

            }

        }

        System.out.println();
        System.out.println("=================================");
        System.out.println("             GAME OVER");
        System.out.println("=================================");

        if (!correct) {

            System.out.println("Sorry, " + player.getName() + "!");
            System.out.println("You ran out of guesses.");
            System.out.println("The correct number was " + secretNumber);

        }

        System.out.println();
        System.out.println("GUESSING HISTORY");

        player.displayGuesses();

        System.out.printf("%nTotal guesses used: %d%n", guessesUsed);

        System.out.println("Thanks for playing!");

        input.close();

    }
}

// Player class
class Player {

    private String name;

    private ArrayList<Integer> guesses = new ArrayList<>();

    public Player(String name) {

        this.name = name;

    }

    public String getName() {

        return name;

    }

    public void addGuess(int guess) {

        guesses.add(guess);

    }

    public void displayGuesses() {

        if (guesses.isEmpty()) {

            System.out.println("No guesses were made.");

        } else {

            for (int i = 0; i < guesses.size(); i++) {

                System.out.printf("Guess %d: %d%n",
                        i + 1, guesses.get(i));

            }

        }

    }

}
