package com.mycompany.phonenumbergenerator;

import java.util.Random;
import java.util.Scanner;

/**
 *
 * @author acalabrese2027
 */
public class Phonenumbergenerator {

    public static void main(String[] args) {

        Random random = new Random();
        Scanner scanner = new Scanner(System.in);

        System.out.println("Random Phone Number Generator");

        while (true) {

            // Generate the first three digits
            int first = random.nextInt(8) + 2;

            // Generate the next two digits
            int second = random.nextInt(100);

            // Generate the middle three digits
            int middle = random.nextInt(1000);

            // Generate the last four digits
            int last = random.nextInt(10000);

            // Format the phone number
            String phoneNumber = String.format(
                    "%d%02d-%03d-%04d",
                    first,
                    second,
                    middle,
                    last
            );

            System.out.println("Generated phone number: " + phoneNumber);

            // Ask the user if they want another number
            System.out.print(
                    "Press p to generate another phone number, or q to quit: "
            );

            String choice = scanner.nextLine();

            if (!choice.equalsIgnoreCase("p")) {
                break;
            }

            System.out.println();
        }

        System.out.println("Goodbye!");

        scanner.close();
    }
}
