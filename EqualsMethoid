package com.mycompany.equalsmethod;

/**
 *
 * @author acalabrese2027
 */
public class EqualsMethod {

    public static void main(String[] args) {

        // Create the Shoes object
        Item shoes = new Item();
        shoes.setStrName("Shoes");
        shoes.setPrice(125.99);

        // Create the T Shirt object
        Item tshirt = new Item();
        tshirt.setStrName("T Shirt");
        tshirt.setPrice(19.99);

        // Display both items
        System.out.println(shoes.toString());
        System.out.println(tshirt.toString());

        // Compare the prices
        if (shoes.equals(tshirt)) {
            System.out.println("Same price!");
        } else {
            System.out.println("Not same price!");
        }

        // Determine which item costs more
        if (shoes.getPrice() > tshirt.getPrice()) {
            System.out.println("Shoes are more expensive.");
        } else if (shoes.getPrice() < tshirt.getPrice()) {
            System.out.println("T Shirt is more expensive.");
        } else {
            System.out.println("Both items have the same price.");
        }
    }
}

// Item class
class Item {

    // Instance variables
    private String strName;
    private double dblPrice;

    // Price comparison tolerance
    public final double TOLERANCE = 0.01;

    // Constructor
    public Item() {
        strName = "";
        dblPrice = 0.0;
    }

    // Setter for item name
    public void setStrName(String strName) {
        this.strName = strName;
    }

    // Getter for item name
    public String getStrName() {
        return strName;
    }

    // Setter for item price
    public void setPrice(double inPrice) {
        dblPrice = inPrice;
    }

    // Getter for item price
    public double getPrice() {
        return dblPrice;
    }

    // Compare two items by price
    public boolean equals(Item inItem) {
        if (inItem == null) {
            return false;
        }

        if (Math.abs(inItem.dblPrice - this.dblPrice) <= TOLERANCE) {
            return true;
        } else {
            return false;
        }
    }

    // Display the item's name and price
    public String toString() {
        return "Item: " + strName
                + ", Price: "
                + String.format("%.2f", dblPrice);
    }
}
